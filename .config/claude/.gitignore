# Claude Code runtime files
# These files should not be tracked in version control

# Local settings (machine-specific, contains permissions)
settings.local.json

# Command history
history.jsonl

# Log files
*.log

# Debug and runtime directories
debug/
agents/
file-history/
hooks/
ide/
plugins/
projects/
session-env/
shell-snapshots/

# Session and cache data
sessions/
cache/
.update.lock

# Statusline stats (created by statusline.sh)
statusline-stats/

# Backup files (including in subdirectories)
*.backup
**/*.backup
