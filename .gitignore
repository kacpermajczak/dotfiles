# Brewfile lock file (not needed in version control)
Brewfile.lock.json

# Machine-specific zsh config
.config/zsh/zsh.d/99-local.zsh

# Backup files
*.backup
.zshrc.backup

# Claude Code runtime files (if accidentally created in dotfiles directory)
.config/claude/settings.local.json
.config/claude/history.jsonl
.config/claude/**/*.backup
.config/claude/statusline-stats/
